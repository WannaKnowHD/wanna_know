# 복사해서 .env로 저장한 뒤 값을 채우세요. .env는 커밋하지 않습니다.
OPENAI_API_KEY=
MODEL_TEXT=
MODEL_VISION=
EMBEDDING_MODEL=text-embedding-3-small

DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
# ※ DB_NAME 이 앱이 붙는 데이터베이스를 정한다. 코드에는 DB 이름이 없으므로 이 값만 바꾸면 된다.
#   - 지금(프론트엔드·로그인 확인 단계): Aiven 기본 DB 인 test 로 붙어서 테스트한다.
#       DB_NAME=test
#   - 실제 DB 를 만든 뒤: 그 DB 이름으로 바꾸고 python scripts/seed.py 로 테이블·계정을 다시 만든다.
#       DB_NAME=(실제 사용할 DB 이름)
#   ※ test 는 연습용이므로 여기에 만든 계정·기록은 실제 DB 로 옮겨지지 않는다.
DB_NAME=
DB_SSL_CA=certs/ca.pem

# 로그인 세션 (gr.BrowserState). 고정값이어야 서버 재시작 후에도 로그인 유지
BROWSER_STORAGE_KEY=cv_session
BROWSER_SECRET=
SESSION_HOURS=8

# 기준값
NOT_FOUND_THRESHOLD=0.55
IMAGE_CONFIDENCE_THRESHOLD=0.6

# 초기 계정 비밀번호(scripts/seed.py 전용, 8자 이상)
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=