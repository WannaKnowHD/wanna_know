  "type": "troubleshooting",
  "symptom": "Carcass fatigue at idler junction.*",
  "alarm_codes": [],
  "causes": [
    {
      "cause_id": "TS-FENNERBELT-T01-22#c1",
      "cause": "Improper transition between troughed belt and terminal pulleys",
      "actions": [
        "adjust transition in accordance with CEMA standards and Fenner Dunlop Belting Catalogs."
      ]
    },
    {
      "cause_id": "TS-FENNERBELT-T01-22#c2",
      "cause": "Severe convex (hump) vertical curve",
      "actions": [
        "decrease idler spacing in curve",
        "increase curve radius."
      ]
    },
    {
      "cause_id": "TS-FENNERBELT-T01-22#c3",
      "cause": "Excessive forward tilt of trough rolls",
      "actions": [
        "reduce forward tilt of idlers to no more than 2° from vertical."
      ]
    },
    {
      "cause_id": "TS-FENNERBELT-T01-22#c4",
      "cause": "Excess gap between idler rolls",
      "actions": [
        "replace idlers",
        "replace with heavier belt."
      ]
    },
    {
      "cause_id": "TS-FENNERBELT-T01-22#c5",
      "cause": "Insufficient transverse stiffness",
      "actions": [
        "replace with the proper belt."
      ]
    },
    {
      "cause_id": "TS-FENNERBELT-T01-22#c6",
      "cause": "Excessive sag between idlers causing load to work and shuffle on belt as it passes over idlers",
      "actions": [
        "increase tension if unnecessarily low",
        "reduce idler spacing."
      ]
    }
  ],
  "safety": []
}
